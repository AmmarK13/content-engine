{
  "$defs": {
    "StageRecordV1": {
      "additionalProperties": false,
      "description": "One row of the manifest's per-stage checklist.",
      "properties": {
        "stage_id": {
          "description": "e.g. S00, S10, S20 ... G80, G90, S100",
          "title": "Stage Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StageStatus",
          "default": "pending"
        },
        "attempt": {
          "default": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "output_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "stage_id"
      ],
      "title": "StageRecordV1",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The central checklist record for one run \u2014 tracks the status of\nevery stage/gate for this specific video from S00 through S100.",
  "properties": {
    "run_id": {
      "description": "Unique ID for this pipeline run",
      "title": "Run Id",
      "type": "string"
    },
    "idea_request_id": {
      "description": "ID of the originating IdeaRequestV1",
      "title": "Idea Request Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecordV1"
      },
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "idea_request_id"
  ],
  "title": "ProductionManifestV1",
  "type": "object"
}
